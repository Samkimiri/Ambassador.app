# ==============================================================================
# SCDS AMBASSADOR HUB - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local and provide your real Supabase credentials.
# If Supabase credentials are not set, the app runs in an explicitly labeled
# Local Development / Demo Mode with full interactive persistence.

# 1. Public App URL (used for generating referral links like /join?ref=CODE)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SCDS_MAIN_WEBSITE=https://samcreativedesignschool.com

# 2. Supabase Configuration (Public Browser Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=

# 4. Optional M-Pesa Daraja Integration (Server-side only, if automated payouts enabled)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

