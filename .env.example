# ==============================================================================
# SCDS AMBASSADOR HUB - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local and populate your credentials.
# If credentials are not set, the app runs in an explicitly labeled
# Local Development / Demo Mode with full interactive persistence.

# 1. Public App URL (used for generating referral links like /join?ref=CODE)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SCDS_MAIN_WEBSITE=https://samcreativedesignschool.com

# 2. Supabase Configuration (Public Browser Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=

# 4. Safaricom Daraja M-Pesa Integration (C2B Enrolment & B2C Payouts)
# Set to 'sandbox' for testing, 'production' for live payments
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=
MPESA_CALLBACK_URL=http://localhost:3000/api/mpesa/callback

# 5. Transactional Email Notifications (Resend / SendGrid)
# Optional: In development, emails are cleanly simulated without failure
RESEND_API_KEY=
EMAIL_FROM=SCDS Ambassador Hub <ambassadors@samcreativedesignschool.com>
